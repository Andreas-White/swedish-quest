[{"explanations":["Correct: har + supine for a finished lunch.","Åt is past, not supine.","Äter is present; never after har."],"kind":"choice","options":["Jag har ätit lunch.","Jag har åt lunch.","Jag har äter lunch."],"prompt":"Say “I have eaten lunch.”"},{"explanations":["Correct: druckit is the supine.","Drack is past, not supine.","Dricker is present."],"kind":"choice","options":["Han har druckit kaffe.","Han har drack kaffe.","Han har dricker kaffe."],"prompt":"Say “He has drunk coffee.”"},{"explanations":["Correct: läst is the supine.","Läste is past tense.","Läser is present tense."],"kind":"choice","options":["Vi har läst tidningen.","Vi har läste tidningen.","Vi har läser tidningen."],"prompt":"Say “We have read the newspaper.”"},{"explanations":["Correct: gått is the supine of gå.","Gick is past, not supine.","Går is present."],"kind":"choice","options":["De har gått nu.","De har gick nu.","De har går nu."],"prompt":"Say “They have gone now.”"},{"explanations":["Correct: kommit is the supine.","Kom is past/present-ish; need kommit.","Kommer is present."],"kind":"choice","options":["Bussen har kommit.","Bussen har kom.","Bussen har kommer."],"prompt":"Say “The bus has come.”"},{"explanations":["Correct: gjort is the supine.","Gjorde is past tense.","Gör is present tense."],"kind":"choice","options":["Jag har gjort läxan.","Jag har gjorde läxan.","Jag har gör läxan."],"prompt":"Say “I have done the homework.”"},{"explanations":["Correct: varit is the supine.","Var is past, not supine.","Är is present."],"kind":"choice","options":["Vi har varit sjuka.","Vi har var sjuka.","Vi har är sjuka."],"prompt":"Say “We have been ill.”"},{"explanations":["Correct: question with Har + supine.","Har du åt? uses past.","Har du äter? uses present."],"kind":"choice","options":["Har du ätit?","Har du åt?","Har du äter?"],"prompt":"Ask “Have you eaten?”"},{"explanations":["Correct: inte before the supine.","Läst must not change after inte.","Läser is present; wrong here."],"kind":"choice","options":["Jag har inte läst den.","Jag har inte läste den.","Jag har inte läser den."],"prompt":"Say “I have not read it.”"},{"explanations":["Correct: bott is the supine of bo.","Bodde is past tense.","Bor is present tense."],"kind":"choice","options":["Vi har bott här länge.","Vi har bodde här länge.","Vi har bor här länge."],"prompt":"Say “We have lived here a long time.”"}]