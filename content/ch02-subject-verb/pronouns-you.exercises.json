[{"explanations":["Du is for one person.","Ni is for a group.","De means they."],"kind":"choice","options":["Du talar svenska.","Ni talar svenska.","De talar svenska."],"prompt":"You speak to one friend. Pick the right sentence."},{"explanations":["Ni is for many people.","Du is for one person.","Vi means we."],"kind":"choice","options":["Bor ni här?","Bor du här?","Bor vi här?"],"prompt":"You ask a whole family “Do you all live here?”"},{"explanations":["De = they.","Du = you (one).","Ni = you (many)."],"kind":"choice","options":["de","du","ni"],"prompt":"Which pronoun means “they”?"},{"explanations":["Written de, spoken dom.","Dom is only speech, not writing.","Ni means you."],"kind":"choice","options":["De bor här.","Dom bor här.","Ni bor här."],"prompt":"Pick the correct written sentence for “They live here.”"},{"explanations":["Vi = we.","De = they.","Ni = you many."],"kind":"choice","options":["Vi bor här.","De bor här.","Ni bor här."],"prompt":"Which means “We live here.”?"},{"explanations":["Du is right for teachers and bosses too.","Ni to one person is rare and formal.","De means they."],"kind":"choice","options":["du","ni","de"],"prompt":"Which “you” do Swedes normally use for one person?"},{"explanations":["Han = he.","Hon = she.","De = they."],"kind":"choice","options":["Han bor här.","Hon bor här.","De bor här."],"prompt":"Which means “He lives here.”?"},{"explanations":["Hon = she.","Han = he.","Vi = we."],"kind":"choice","options":["Hon bor här.","Han bor här.","Vi bor här."],"prompt":"Which means “She lives here.”?"},{"explanations":["Jag heter Anna. needs no extra pronoun.","Jag heter du Anna adds a wrong word.","Jag heter de Anna adds a wrong word."],"kind":"choice","options":["Jag heter Anna.","Jag heter du Anna.","Jag heter de Anna."],"prompt":"Pick the correct sentence."},{"explanations":["Jag = I.","Du = you.","Vi = we."],"kind":"choice","options":["jag","du","vi"],"prompt":"Which pronoun means “I”?"}]