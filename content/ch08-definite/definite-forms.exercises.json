[{"explanations": ["En words add -en: boken.", "Bok is indefinite.", "The bok mixes English with Swedish."], "kind": "choice", "options": ["boken", "bok", "the bok"], "prompt": "Pick “the book.” (en bok → ?)"}, {"explanations": ["Ett words add -et: huset.", "Hus is indefinite.", "Ett huset wrongly keeps ett."], "kind": "choice", "options": ["huset", "hus", "ett huset"], "prompt": "Pick “the house.” (ett hus → ?)"}, {"explanations": ["En bil takes -en: bilen.", "Bil is indefinite.", "En bilen wrongly keeps en."], "kind": "choice", "options": ["bilen", "bil", "en bilen"], "prompt": "Pick “the car.” (en bil → ?)"}, {"explanations": ["Flicka already ends in a vowel, so just add -n: flickan.", "Flicka is indefinite.", "Flickaen keeps the full -en wrongly."], "kind": "choice", "options": ["flickan", "flicka", "flickaen"], "prompt": "Pick “the girl.” (en flicka → ?)"}, {"explanations": ["Äpple ends in a vowel, so add -t: äpplet.", "Äpple is indefinite.", "Äppleet doubles wrongly."], "kind": "choice", "options": ["äpplet", "äpple", "äppleet"], "prompt": "Pick “the apple.” (ett äpple → ?)"}, {"explanations": ["Rum doubles its consonant: rummet.", "Rum is indefinite.", "Rumen uses the en ending."], "kind": "choice", "options": ["rummet", "rum", "rumen"], "prompt": "Pick “the room.” (ett rum → ?)"}, {"explanations": ["The definite subject takes the definite form: Boken är bra.", "En bok är bra is indefinite.", "En boken is never allowed."], "kind": "choice", "options": ["Boken är bra.", "En bok är bra.", "En boken är bra."], "prompt": "Pick “The book is good.”"}, {"explanations": ["Huset is ett, so the adjective after är is stort.", "Stor matches en words.", "Stora matches plurals."], "kind": "choice", "options": ["Huset är stort.", "Huset är stor.", "Huset är stora."], "prompt": "Pick “The house is big.”"}, {"explanations": ["After first mention, use the definite: Bilen är röd.", "En bil är röd is indefinite.", "En bilen keeps en with the definite form."], "kind": "choice", "options": ["Bilen är röd.", "En bil är röd.", "En bilen är röd."], "prompt": "You said “Jag ser en bil.” Now say “The car is red.”"}, {"explanations": ["Never keep ett with the definite: just huset.", "Ett huset is a double marking error.", "The huset mixes English with Swedish."], "kind": "choice", "options": ["huset", "ett huset", "the huset"], "prompt": "Pick the correct definite form (no extra article)."}]