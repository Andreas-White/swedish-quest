[{"explanations": ["En words: boken with -en.", "Bok is indefinite.", "En boken wrongly keeps en."], "kind": "choice", "options": ["boken", "bok", "en boken"], "prompt": "Pick “the book.” (definite lesson)"}, {"explanations": ["Ett words: huset with -et.", "Hus is indefinite.", "Ett huset wrongly keeps ett."], "kind": "choice", "options": ["huset", "hus", "ett huset"], "prompt": "Pick “the house.”"}, {"explanations": ["Hus is ett, so mitt.", "Min matches en words.", "Mina matches plurals."], "kind": "choice", "options": ["mitt hus", "min hus", "mina hus"], "prompt": "Pick “my house.” (possessives lesson)"}, {"explanations": ["Plural takes dina: dina böcker.", "Din is en singular.", "Ditt is ett singular."], "kind": "choice", "options": ["dina böcker", "din böcker", "ditt böcker"], "prompt": "Pick “your books.”"}, {"explanations": ["Den här matches en words and needs the definite noun boken.", "Det här matches ett words, not bok.", "Den här bok misses the definite ending."], "kind": "choice", "options": ["den här boken", "det här boken", "den här bok"], "prompt": "Pick “this book.” (demonstratives lesson)"}, {"explanations": ["Det här matches ett words and needs huset.", "Den här matches en words, not hus.", "Det här hus misses the definite ending."], "kind": "choice", "options": ["det här huset", "den här huset", "det här hus"], "prompt": "Pick “this house.”"}, {"explanations": ["Plural pointer de här needs the plural definite bilarna.", "De här bilen mixes plural pointer with singular noun.", "Den här bilarna mixes singular pointer with plural noun."], "kind": "choice", "options": ["de här bilarna", "de här bilen", "den här bilarna"], "prompt": "Pick “these cars.”"}, {"explanations": ["Add -s to the owner with no apostrophe: Marias bil.", "Maria's uses an English apostrophe.", "Marias bilen wrongly makes the thing definite."], "kind": "choice", "options": ["Marias bil.", "Maria's bil.", "Marias bilen."], "prompt": "Pick “Maria's car.” (genitive lesson: no apostrophe)"}, {"explanations": ["Definite owners take -s and the thing stays indefinite: barnens rum.", "Barnen's uses an apostrophe.", "Barnens rummet wrongly makes the room definite."], "kind": "choice", "options": ["barnens rum", "barnen's rum", "barnens rummet"], "prompt": "Pick “the children's room.”"}, {"explanations": ["Names ending in -s add nothing: Anders bil.", "Anderss doubles the s.", "Ander's uses an apostrophe."], "kind": "choice", "options": ["Anders bil.", "Anderss bil.", "Ander's bil."], "prompt": "Pick “Anders' car.” (name already ends in s)"}]