[{"explanations":["Correct: third-person reflexive is sig.","Honom means another man.","Mig is first person."],"kind":"choice","options":["Han tvättar sig.","Han tvättar honom.","Han tvättar mig."],"prompt":"Say “He washes himself.”"},{"explanations":["Correct: lära sig is the reflexive chunk.","Lär dem means teaching others.","Lär henne means teaching her."],"kind":"choice","options":["Hon lär sig svenska.","Hon lär dem svenska.","Hon lär henne svenska."],"prompt":"Say “She is learning Swedish.”"},{"explanations":["Correct: plural reflexive verb + oss.","Sätter sig is third person only.","Er is for commands, not vi."],"kind":"choice","options":["Vi sätter oss här.","Vi sätter sig här.","Vi sätter er här."],"prompt":"Say “We sit down here.”"},{"explanations":["Correct: first person uses mig.","Sig is third person only.","Dig is second person."],"kind":"choice","options":["Jag tvättar mig.","Jag tvättar sig.","Jag tvättar dig."],"prompt":"Say “I wash myself.”"},{"explanations":["Correct: De pairs with sig.","Dem means other people.","Er is second person plural."],"kind":"choice","options":["De sätter sig ner.","De sätter dem ner.","De sätter er ner."],"prompt":"Say “They sit down.”"},{"explanations":["Correct: trivas is inherently reflexive in meaning.","Trivas dig adds a wrong object.","Trivs sig mixes third-person sig with du."],"kind":"choice","options":["Trivs du på jobbet?","Trivs dig på jobbet?","Trivs sig du på jobbet?"],"prompt":"Ask “Do you enjoy your job / feel at home at work?”"},{"explanations":["Correct: jag trivs needs no extra object.","Mig is wrong with trivs.","Sig is third person only."],"kind":"choice","options":["Jag trivs i Sverige.","Jag trivs mig i Sverige.","Jag trivs sig i Sverige."],"prompt":"Say “I feel at home in Sweden.”"},{"explanations":["Correct: du pairs with dig.","Sig is third person only.","Er is plural/formal command."],"kind":"choice","options":["Du tvättar dig.","Du tvättar sig.","Du tvättar er."],"prompt":"Say “You wash yourself.” (one friend)"},{"explanations":["Correct: själv stresses doing it alone.","Själv needs the reflexive first.","Honom means someone else."],"kind":"choice","options":["Hon tvättar sig själv.","Hon tvättar själv sig.","Hon tvättar honom själv."],"prompt":"Say “She washes herself (by herself).”"},{"explanations":["Correct: imperative-style care phrase for du.","Dig sig mixes two objects.","Er is for several people."],"kind":"choice","options":["Ta hand om dig själv!","Ta hand om dig sig!","Ta hand om er själv du!"],"prompt":"Say “Take care of yourself!” (to one friend)"}]