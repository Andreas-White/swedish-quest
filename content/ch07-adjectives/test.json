[{"explanations": ["Ett words need rött.", "Röd is the en form.", "Röda is plural."], "kind": "choice", "options": ["Ett rött hus.", "Ett röd hus.", "Ett röda hus."], "prompt": "Pick “A red house.” (colors lesson)"}, {"explanations": ["Svart stays the same for ett words.", "Svartt is not a word.", "Svarta is plural."], "kind": "choice", "options": ["Huset är svart.", "Huset är svartt.", "Huset är svarta."], "prompt": "Pick “The house is black.”"}, {"explanations": ["One person uses the base form glad.", "Glada is plural.", "Glatt is the ett form."], "kind": "choice", "options": ["Hon är glad.", "Hon är glada.", "Hon är glatt."], "prompt": "Pick “She is happy.”"}, {"explanations": ["Plural people need the -a form: snälla.", "Snäll is singular.", "Snällt is the ett singular form."], "kind": "choice", "options": ["De är snälla.", "De är snäll.", "De är snällt."], "prompt": "Pick “They are kind.”"}, {"explanations": ["Ett words add -t: stort.", "Stor is the en form.", "Stora is plural."], "kind": "choice", "options": ["Ett stort hus.", "Ett stor hus.", "Ett stora hus."], "prompt": "Pick “A big house.” (agreement lesson)"}, {"explanations": ["Plural subject bilarna needs stora after är.", "Stor is singular.", "Stort is ett singular."], "kind": "choice", "options": ["Bilarna är stora.", "Bilarna är stor.", "Bilarna är stort."], "prompt": "Pick “The cars are big.”"}, {"explanations": ["Than is än in Swedish.", "Som means as/like, not than here.", "Och means and."], "kind": "choice", "options": ["Min bil är större än din.", "Min bil är större som din.", "Min bil är större och din."], "prompt": "Pick “My car is bigger than yours.” (comparison lesson)"}, {"explanations": ["Short adjectives take the -are ending: billigare.", "Mer billig is not used for short adjectives.", "Billigast is the superlative (cheapest)."], "kind": "choice", "options": ["Min bil är billigare.", "Min bil är mer billig.", "Min bil är billigast."], "prompt": "Pick “My car is cheaper.”"}, {"explanations": ["Störst is the superlative: biggest.", "Större is the comparative (bigger).", "Stor is the base form (big)."], "kind": "choice", "options": ["Han är störst i klassen.", "Han är större i klassen.", "Han är stor i klassen."], "prompt": "Pick “He is the biggest in the class.”"}, {"explanations": ["Definite superlatives add -a: största.", "Störst is the indefinite superlative form.", "Större is the comparative."], "kind": "choice", "options": ["Den största bilen.", "Den störst bilen.", "Den större bilen."], "prompt": "Pick “The biggest car.”"}]