[{"explanations":["Correct: verb second — gjorde du.","Du gjorde is statement order.","Göra du is infinitive + pronoun."],"kind":"choice","options":["Vad gjorde du igår?","Vad du gjorde igår?","Vad göra du igår?"],"prompt":"Pick the correct Swedish for “What did you do yesterday?”"},{"explanations":["Correct: Var + var + du.","Du var is statement order.","Var du var doubles var."],"kind":"choice","options":["Var var du igår?","Var du var igår?","Var du var du igår?"],"prompt":"Pick the correct Swedish for “Where were you yesterday?”"},{"explanations":["Correct: past åt in question.","Äter is present.","Ätade is not a form."],"kind":"choice","options":["Vad åt du?","Vad äter du igår?","Vad ätade du?"],"prompt":"Pick the correct Swedish for “What did you eat?”"},{"explanations":["Correct: verb + inte.","Inte before verb is wrong.","Ate inte alone lacks the verb."],"kind":"choice","options":["Jag gick inte ut.","Jag inte gick ut.","Jag inte ut."],"prompt":"Pick the correct Swedish for “I did not go out.”"},{"explanations":["Correct: drack inte kaffe.","Drickte is not a form.","Inte drack reverses the order."],"kind":"choice","options":["Vi drack inte kaffe.","Vi drickte inte kaffe.","Vi inte drack kaffe."],"prompt":"Pick the correct Swedish for “We did not drink coffee.”"},{"explanations":["Correct: var inte här.","Var här inte puts inte last wrongly alone.","Inte var här reverses order."],"kind":"choice","options":["Hon var inte här.","Hon var här inte här.","Hon inte var här."],"prompt":"Pick the correct Swedish for “She was not here.”"},{"explanations":["Correct: läste en bok.","Läser is present.","Läsade is not a form."],"kind":"choice","options":["Jag läste en bok.","Jag läser en bok igår.","Jag läsade en bok."],"prompt":"Pick the correct Swedish for “I read a book.” (past)"},{"explanations":["Correct: köpte in past question.","Köper is present.","Köpadde is not a form."],"kind":"choice","options":["Vad köpte du?","Vad köper du igår?","Vad köpadde du?"],"prompt":"Pick the correct Swedish for “What did you buy?”"},{"explanations":["Correct: kom inte.","Kommade is not a form.","Inte kom reverses order."],"kind":"choice","options":["De kom inte igår.","De kommade inte igår.","De inte kom igår."],"prompt":"Pick the correct Swedish for “They did not come yesterday.”"},{"explanations":["Correct: hade inte tid.","Haade is not a form.","Inte hade reverses order."],"kind":"choice","options":["Jag hade inte tid.","Jag haade inte tid.","Jag inte hade tid."],"prompt":"Pick the correct Swedish for “I did not have time.”"}]