# Swedish Quest — Next.js + SQLite production app
# Copy to .env for local dev. NEVER commit real secrets.

DATABASE_URL="file:./data/app.db"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Email magic-link / verification (stub until you add SMTP).
# Example: smtp://user:pass@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="Swedish Quest <noreply@example.com>"

# Google OAuth (stub until you create a client in Google Cloud Console).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Cloud TTS upgrade path (optional for v1, Web Speech API is default).
# Put JSON key path or leave empty to serve 501 with instructions.
GOOGLE_TTS_CREDENTIALS=""
GOOGLE_TTS_VOICE="sv-SE-Chirp3-HD-Aoede"
